nel\">\n+    <h2>Awaiting your decision</h2>\n+    <div class=\"list\" id=\"reviews\"></div>\n+    <p class=\"muted\" id=\"empty\" hidden>Nothing is waiting for you. The agent's next task that requires review will appear here.</p>\n+  </section>\n+  <section class=\"panel\">\n+    <div id=\"detail\" hidden>\n+      <h2 id=\"title\"></h2>\n+      <div class=\"kind\" id=\"meta\"></div>\n+      <p class=\"muted\">Input the agent was given</p>\n+      <pre id=\"input\"></pre>\n+      <p class=\"muted\">The artefact under review. Edit it to override; the patch is computed from your edit.</p>\n+      <textarea id=\"artefact\" spellcheck=\"false\"></textarea>\n+      <div class=\"row\">\n+        <input id=\"rationale\" placeholder=\"Why (required to edit or reject)\" style=\"flex:1; min-width: 240px\">\n+        <input id=\"tags\" placeholder=\"tags, comma separated\" style=\"width: 220px\">\n+      </div>\n+      <div class=\"row\">\n+        <button class=\"primary\" id=\"approve\">Approve as written</button>\n+        <button id=\"override\">Override with my edit</button>\n+        <button class=\"danger\" id=\"reject\">Reject</button>\n+        <label class=\"muted\"><input type=\"checkbox\" id=\"revision\"> ask for a revision</label>\n+      </div>\n+      <div class=\"notice\" id=\"notice\"></div>\n+    </div>\n+    <p class=\"muted\" id=\"pick\" >Pick a review on the left.</p>\n+    <h2 style=\"margin-top:18px\">The chain</h2>\n+    <div class=\"chain\" id=\"chain\"></div>\n+  </section>\n+</main>\n+<script type=\"module\">\n+import { makeClient, generateSigner, signerFromJwk, jsonPatch, deepEqual, contentHash } from \"./chap-client.mjs\";\n+\n+const $ = (id) => document.getElementById(id);\n+const CHAIN_ROWS = 200;\n+let config = null, client = null, reviews = [], selected = null;\n+let chainShown = -1;        // the length of the log the chain view last rendered\n+const chainOpen = new Set(); // the entries left open, by seq, kept across renders\n+\n+function reviewerFromHash() {\n+  return new URLSearchParams(location.hash.slice(1)).get(\"reviewer\") || \"\";\n+}\n+\n+async function loadConfig() {\n+  config = await (await fetch(\"/api/config\")).json();\n+  $(\"workspace\").textContent = `${config.workspace} · ${config.profiles.join(\", \")}`;\n+  const select = $(\"reviewer\");\n+  select.innerHTML = \"\";\n+  for (const h of config.humans) {\n+    const o = document.createElement(\"option\");\n+    o.value = h.uri; o.textContent = h.display_name ? `${h.display_name} (${h.uri})` : h.uri;\n+    select.appendChild(o);\n+  }\n+  const wanted = reviewerFromHash();\n+  if (wanted && config.humans.some((h) => h.uri === wanted)) select.value = wanted;\n+  await setReviewer(select.value);\n+}\n+\n+// Under security-signed/1.0 the desk signs in the browser. The key is\n+// generated here, kept in localStorage, and registered at participant.join,\n+// which the coordinator accepts unsigned.\n+async function signerFor(uri) {\n+  if (!config.require_signatures) return null;\n+  const storeKey = `chap-desk-key:${config.workspace}:${uri}`;\n+  const saved = localStorage.getItem(storeKey);\n+  if (saved) return signerFromJwk(uri, JSON.parse(saved));\n+  const signer = await generateSigner(uri);\n+  localStorage.setItem(storeKey, JSON.stringify(signer.privateJwk));\n+  return signer;\n+}\n+\n+async function setReviewer(uri) {\n+  location.hash = `reviewer=${encodeURIComponent(uri)}`;\n+  const signer = await signerFor(uri);\n+  client = makeClient({ workspace: config.workspace, from: uri, signer });\n+  $(\"signing\").textContent = signer ? `signing as ${uri} with key ${signer.kid}` : \"signing off\";\n+  $(\"signing\").className = \"badge \" + (signer ? \"good\" : \"off\");\n+  if (signer) {\n+    // A first join registers the key; a later join by the same member is\n+    // accepted and adds nothing. A re-join cannot add a key, so a cleared\n+    // browser storage means a new participant URI.\n+    const me = config.humans.find((h) =