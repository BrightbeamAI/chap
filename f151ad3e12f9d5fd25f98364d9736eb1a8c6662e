 showDetail() {\n+  $(\"detail\").hidden = !selected;\n+  $(\"pick\").hidden = !!selected;\n+  if (!selected) return;\n+  $(\"title\").textContent = `${selected.kind} · ${selected.task_id}`;\n+  $(\"meta\").textContent = `assigned to ${selected.assignee} · reviewers ${selected.reviewers.join(\", \")} · rule ${selected.rule}`;\n+  $(\"input\").textContent = JSON.stringify(selected.input, null, 2);\n+  $(\"artefact\").value = JSON.stringify(selected.artefact, null, 2);\n+  $(\"rationale\").value = \"\"; $(\"tags\").value = \"\"; $(\"revision\").checked = false;\n+  notice(\"\");\n+}\n+\n+function notice(message) { $(\"notice\").textContent = message; }\n+function tags() { return $(\"tags\").value.split(\",\").map((t) => t.trim()).filter(Boolean); }\n+function escapeHtml(s) { return String(s).replace(/[&<>\"]/g, (c) => ({ \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\" }[c])); }\n+\n+async function decide(fn) {\n+  const buttons = [\"approve\", \"override\", \"reject\"].map($);\n+  buttons.forEach((b) => (b.disabled = true));\n+  notice(\"\");\n+  try {\n+    await fn();\n+    selected = null;\n+    await refresh();\n+    showDetail();\n+  } catch (e) {\n+    notice(e.message);\n+  } finally {\n+    buttons.forEach((b) => (b.disabled = false));\n+  }\n+}\n+\n+// Every decision carries approved_artefact_digest, the hash of the artefact\n+// shown here, so the coordinator refuses the decision if the artefact under\n+// review is no longer the one the reviewer saw (review/1.0 §3.2).\n+$(\"approve\").onclick = () => decide(async () => {\n+  await client.call(\"decide.approve\", { task_id: selected.task_id, approved_artefact_digest: await contentHash(selected.artefact), comment: $(\"rationale\").value || undefined, tags: tags().length ? tags() : undefined });\n+});\n+\n+$(\"override\").onclick = () => decide(async () => {\n+  let edited;\n+  try { edited = JSON.parse($(\"artefact\").value); } catch { throw new Error(\"The edit is not valid JSON.\"); }\n+  if (deepEqual(edited, selected.artefact)) throw new Error(\"Nothing changed. Approve as written, or edit the artefact.\");\n+  const rationale = $(\"rationale\").value.trim();\n+  if (!rationale) throw new Error(\"An override needs a rationale.\");\n+  await client.call(\"decide.override\", { task_id: selected.task_id, approved_artefact_digest: await contentHash(selected.artefact), diff: jsonPatch(selected.artefact, edited), rationale, tags: tags().length ? tags() : undefined, intent_preserved: true });\n+});\n+\n+$(\"reject\").onclick = () => decide(async () => {\n+  const rationale = $(\"rationale\").value.trim();\n+  if (!rationale) throw new Error(\"A rejection needs a reason.\");\n+  await client.call(\"decide.reject\", { task_id: selected.task_id, approved_artefact_digest: await contentHash(selected.artefact), comment: rationale, tags: tags().length ? tags() : undefined, request_revision: $(\"revision\").checked || undefined });\n+});\n+\n+// The last CHAIN_ROWS entries, newest first, read with audit.read over a\n+// range so a long-running desk does not fetch the whole log each time.\n+async function renderChain(total) {\n+  const box = $(\"chain\");\n+  try {\n+    const from = Math.max(0, total - CHAIN_ROWS);\n+    const { entries } = await client.call(\"audit.read\", { range: { from_seq: from } });\n+    box.innerHTML = \"\";\n+    if (from > 0) {\n+      const p = document.createElement(\"p\");\n+      p.className = \"muted\";\n+      p.textContent = `The last ${entries.length} of ${total} entries.`;\n+      box.appendChild(p);\n+    }\n+    for (const e of entries.slice().reverse()) {\n+      const call = e.envelope ?? e.request;\n+      const d = document.createElement(\"details\");\n+      d.open = chainOpen.has(e.seq);\n+      d.ontoggle = () => { if (d.open) chainOpen.add(e.seq); else chainOpen.delete(e.seq); };\n+      const refused = e.outcome ? ` <span class=\"refused\">refused ${e.outcome.code}</span>` : \"\";\n+      d.innerHTML = `<summary>#