              "patch": "diff --git a/packages/create-chap-app/templates/_shared/desk/desk.css b/packages/create-chap-app/templates/_shared/desk/desk.css\nnew file mode 100644\nindex 0000000000000000000000000000000000000000..51db8e91663ae0a9443533cf11e08ec5121317ed\n--- /dev/null\n+++ b/packages/create-chap-app/templates/_shared/desk/desk.css\n@@ -0,0 +1,264 @@\n+/* The CHAP review desk. One stylesheet, no build step, light and dark. */\n+\n+:root {\n+  --font: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Inter, Roboto, \"Helvetica Neue\", Arial, sans-serif;\n+  --mono: ui-monospace, \"SF Mono\", SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace;\n+  --bg: #f6f7f9;\n+  --panel: #ffffff;\n+  --panel-2: #f1f3f6;\n+  --line: #e2e6eb;\n+  --line-strong: #c9d0d8;\n+  --ink: #16191f;\n+  --ink-2: #4a5362;\n+  --muted: #7a8494;\n+  --accent: #2456d6;\n+  --accent-ink: #ffffff;\n+  --accent-soft: #e8eefc;\n+  --ok: #1e7f45;\n+  --ok-soft: #e3f5ea;\n+  --warn: #b26a00;\n+  --warn-soft: #fff2dc;\n+  --bad: #c0392b;\n+  --bad-soft: #fde8e6;\n+  --add-bg: #e6f7ec;\n+  --add-ink: #14532d;\n+  --del-bg: #fdecea;\n+  --del-ink: #7f1d1d;\n+  --hunk-bg: #eef2f7;\n+  --shadow: 0 1px 2px rgba(16, 24, 40, .06), 0 1px 3px rgba(16, 24, 40, .08);\n+  --radius: 10px;\n+  --radius-s: 6px;\n+  --gap: 12px;\n+  color-scheme: light;\n+}\n+:root[data-theme=\"dark\"] {\n+  --bg: #0f1216;\n+  --panel: #161a20;\n+  --panel-2: #1d222a;\n+  --line: #262c36;\n+  --line-strong: #3a424f;\n+  --ink: #e8ebf0;\n+  --ink-2: #b4bcc8;\n+  --muted: #7f8898;\n+  --accent: #6b93ff;\n+  --accent-ink: #0b1020;\n+  --accent-soft: #1c2740;\n+  --ok: #4cc27a;\n+  --ok-soft: #12301f;\n+  --warn: #e3a44a;\n+  --warn-soft: #3a2a12;\n+  --bad: #f0665a;\n+  --bad-soft: #3b1c1a;\n+  --add-bg: #10331d;\n+  --add-ink: #b7f0c9;\n+  --del-bg: #3a1a18;\n+  --del-ink: #f6c0ba;\n+  --hunk-bg: #1b2230;\n+  --shadow: 0 1px 2px rgba(0, 0, 0, .4);\n+  color-scheme: dark;\n+}\n+@media (prefers-color-scheme: dark) {\n