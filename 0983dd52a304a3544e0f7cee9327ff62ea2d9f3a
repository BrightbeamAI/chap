AP_CORE_ONLY: ${{ inputs.core-only }}\n      run: |\n        cd .chap-conformance/conformance/harness\n        set +e\n        args=(--url=\"${CHAP_URL}\")\n        if [ \"${CHAP_CORE_ONLY}\" = \"true\" ]; then args+=(--core-only); fi\n        npx tsx harness.ts \"${args[@]}\" | tee harness-output.txt\n        rc=${PIPESTATUS[0]}\n        set -e\n\n        # The harness ends with \"All N tests passed.\" or \"F of T tests failed.\"\n        summary=$(grep -oE '[0-9]+ of [0-9]+ tests failed' harness-output.txt | tail -1 || true)\n        if [ -n \"$summary\" ]; then\n          failed=${summary%% of *}\n          total=$(echo \"$summary\" | grep -oE 'of [0-9]+' | grep -oE '[0-9]+')\n          passed=$((total - failed))\n        else\n          passed=$(grep -oE '[0-9]+ tests passed' harness-output.txt | tail -1 | grep -oE '[0-9]+' || echo 0)\n          failed=0\n        fi\n        echo \"passed=$passed\" >> \"$GITHUB_OUTPUT\"\n        echo \"failed=$failed\" >> \"$GITHUB_OUTPUT\"\n\n        if [ \"$rc\" -eq 2 ]; then\n          echo \"::error::The conformance harness could not run (exit code 2). Check the url input and that the endpoint answers JSON-RPC.\"\n          exit 2\n        fi\n        if [ \"$rc\" -ne 0 ]; then\n          echo \"::error::Conformance harness failed: $failed of $((passed + failed)) vector(s) did not match.\"\n          exit \"$rc\"\n        fi\n",
