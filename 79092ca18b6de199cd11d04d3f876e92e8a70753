              "patch": "diff --git a/packages/coordinator/src/coordinator.ts b/packages/coordinator/src/coordinator.ts\nindex ce09d109610f56c7a62c734028ab8c9eb91c5935..600d16ca8e40362fd434fb55ae517ae65afd6c59 100644\n--- a/packages/coordinator/src/coordinator.ts\n+++ b/packages/coordinator/src/coordinator.ts\n@@ -551,7 +551,9 @@ export class Coordinator {\n     let record: WorkspaceRecord;\n     try {\n       record = { id: ws.id, data: this.snapshotOf(ws), version: next, updated_at: this.now() };\n-    } catch {\n+    } catch (err) {\n+      // Nothing was written. The next save builds the whole workspace again.\n+      this.reportStoreError(err, { id: ws.id, version: next });\n       return;\n     }\n \ndiff --git a/packages/coordinator/tests/store_append_only.test.ts b/packages/coordinator/tests/store_append_only.test.ts\nindex b240fdded85fe7e2c34419462233f79e3dd96f15..6ec54ab0c7f64c4493de47fd290d3f2f5e357426 100644\n--- a/packages/coordinator/tests/store_append_only.test.ts\n+++ b/packages/coordinator/tests/store_append_only.test.ts\n@@ -13,7 +13,7 @@ import { mkdtempSync, rmSync } from \"node:fs\";\n import { tmpdir } from \"node:os\";\n import { join } from \"node:path\";\n import { Coordinator } from \"../src/coordinator.ts\";\n-import { MemoryStore, StoreConflictError, type StoreChange } from \"../src/storage/store.ts\";\n+import { MemoryStore, StoreConflictError, type Store, type StoreChange, type WorkspaceRecord } from \"../src/storage/store.ts\";\n \n const PROFILES = [\"core/1.0\", \"review/1.0\", \"control/1.0\", \"handoff/1.0\",\n   \"whisper/1.0\", \"deliberation/1.0\", \"routing/1.0\"];\n@@ -244,6 +244,28 @@ describe(\"failed writes\", () => {\n     assert.equal(lines.length, 1);\n     assert.match(lines[0], /workspace w .*disk full/);\n   });\n+\n+  test(\"a store with only save is told when the workspace cannot be serialised\", () => {\n+    const saved: WorkspaceRecord[] = [];\n+    const store: Store = { load: () => [], save: (r) => { saved.push(