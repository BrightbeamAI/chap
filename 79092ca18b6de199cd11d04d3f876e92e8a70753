                  "before": "name: Starter\n\n# The onboarding path breaks differently from the protocol. Not by failing a\n# vector, but by drifting from what a new developer is told to type. So this\n# workflow runs the literal commands in START_HERE.md and start-here/README.md,\n# drives a real decision through each of them rather than only the do-nothing\n# path, and runs one job against the published wheel, because a pin naming a\n# released version can only rot where the checkout is not on the import path.\n#\n# The Python coordinator is in the trigger paths because the starter is a\n# consumer of it. A behaviour change there breaks the front door, and a filter\n# watching only start-here/ would report that as green. The starter's Python\n# suite also runs in ci.yml on every Python version, unconditionally.\n#\n# Markdown links and em-dashes are checked repository-wide by the Docs job in\n# ci.yml. Neither is repeated here.\n\non:\n  push:\n    branches: [main]\n    paths:\n      - 'start-here/**'\n      - 'START_HERE.md'\n      - 'packages/coordinator-py/**'\n      - '.github/workflows/start-here.yml'\n  pull_request:\n    branches: [main]\n    paths:\n      - 'start-here/**'\n      - 'START_HERE.md'\n      - 'packages/coordinator-py/**'\n      - '.github/workflows/start-here.yml'\n  workflow_dispatch:\n\nconcurrency:\n  group: start-here-${{ github.workflow }}-${{ github.ref }}\n  cancel-in-progress: true\n\njobs:\n  checkout-path:\n    name: From the checkout (${{ matrix.os }}, Python ${{ matrix.python }})\n    runs-on: ${{ matrix.os }}\n    timeout-minutes: 10\n    strategy:\n      fail-fast: false\n      matrix:\n        os: [ubuntu-latest, macos-latest, windows-latest]\n        python: ['3.10', '3.13']\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-python@v5\n        with:\n          python-version: ${{ matrix.python }}\n\n      # START_HERE.md promises Python and nothing else. If this job ever needs\n      # a pip install to pass, that promise is broken and the page is wrong.\n      - name: Behaviour tests\n        run: python -m unittest discover -s start-here/tests -v\n\n      - name: Each demo, deciding for real\n        shell: bash\n        working-directory: start-here\n        run: |\n          set -euo pipefail\n\n          printf 'a\\n' | python hello.py | tee hello.out\n          grep -q 'Reviewed output' hello.out\n\n          printf 'r\\nnot supportable\\n' | python hello.py | tee reject.out\n          grep -q 'rejected this proposal' reject.out\n\n          printf 'e\\n{\"to\":\"c@example.com\",\"subject\":\"Your delivery\",\"body\":\"On its way.\"}\\nno date in tracking\\n' \\\n            | python guarded_tool.py\n          test -f .data/reviewed-email.json \\\n            || { echo \"::error::the guarded function never ran on the reviewed arguments\"; exit 1; }\n          grep -q 'On its way' .data/reviewed-email.json \\\n            || { echo \"::error::the outbox holds the draft, not the edit\"; exit 1; }\n\n          python resume.py                       # leaves a pending review\n          printf 'a\\n' | python resume.py        # finds it again in a new process\n          test -f .data/resume.json \\\n            || { echo \"::error::the second run did not resume the pending review\"; exit 1; }\n\n      - name: Doing nothing authorises nothing\n        shell: bash\n        working-directory: start-here\n        run: |\n          set -euo pipefail\n          rm -rf .data\n          echo \"\" | python guarded_tool.py | tee pending.out\n          grep -q 'The function was not called' pending.out\n          test ! -f .data/reviewed-email.json \\\n            || { echo \"::error::a pending review produced an outbox\"; exit 1; }\n\n  agent-and-browser:\n    name: The agent and browser paths, end to end\n    runs-on: ubuntu-latest\n    timeout-minutes: 10\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-node@v4\n        with:\n          node-version: '22'\n      - uses: actions/setup-python@v5\n        with:\n          python-version: '3.12'\n\n      # Backgrounding and signalling differ enough between Git Bash and a POSIX\n      # shell that doing this in the matrix above would test the shell rather\n      # than the starter, so the desk gets one thorough run here instead.\n      - name: An agent proposes, a reviewer decides, the agent gets the result\n        working-directory: start-here\n        run: |\n          set -euo pipefail\n          python start.py --no-browser --port 0 > desk.log 2>&1 &\n          desk=$!\n          trap 'kill \"$desk\" 2>/dev/null || true' EXIT\n          for _ in $(seq 1 30); do grep -q 'reviewer=' desk.log && break; sleep 1; done\n\n          url=$(grep -o 'http://127.0.0.1:[0-9]*' desk.log | head -1)\n          token=$(grep -o 'reviewer=[A-Za-z0-9_-]*' desk.log | head -1 | cut -d= -f2)\n          test -n \"$url\" && test -n \"$token\" \\\n            || { cat desk.log; echo \"::error::the desk printed no reviewer link\"; exit 1; }\n\n          curl -fsS \"$url/\" > /dev/null\n          curl -fsS -H \"X-CHAP-Reviewer: $token\" \"$url/api/desk\" > desk.json\n          python -c \"import json;d=json.load(open('desk.json'));assert d['verification']['status']=='verified',d['verification']\"\n\n          # agent.mjs proposes over the agent capability and blocks until a\n          # human decides. Nothing else in CI exercises that file.\n          node agent.mjs > agent.log 2>&1 &\n          agent=$!\n          for _ in $(seq 1 30); do grep -q 'Proposed' agent.log && break; sleep 1; done\n          task=$(grep -o 'Proposed [A-Za-z0-9_]*' agent.log | head -1 | cut -d' ' -f2)\n          test -n \"$task\" || { cat agent.log; echo \"::error::agent.mjs proposed nothing\"; exit 1; }\n\n          digest=$(curl -fsS -H \"X-CHAP-Reviewer: $token\" \"$url/api/desk?task=$task\" \\\n                   | python -c \"import json,sys;print(json.load(sys.stdin)['task']['digest'])\")\n          curl -fsS -X POST -H \"X-CHAP-Reviewer: $token\" -H \"Content-Type: application/json\" \\\n            -d \"{\\\"action\\\":\\\"edit\\\",\\\"edited\\\":{\\\"text\\\":\\\"On its way, no date yet.\\\"},\\\"rationale\\\":\\\"tracking has no date\\\",\\\"expected_digest\\\":\\\"$digest\\\"}\" \\\n            \"$url/api/reviews/$task/decision\" > /dev/null\n\n          wait \"$agent\"\n          cat agent.log\n          grep -q 'On its way, no date yet' agent.log \\\n            || { echo \"::error::the Node client did not receive the human's edit\"; exit 1; }\n\n          test -f .data/agent.json || { echo \"::error::no agent connection file\"; exit 1; }\n\n      # The chain proves what was decided, not what the decider saw. These\n      # cover the difference.\n      - name: Hidden-character rendering\n        run: node --test start-here/tests/render.test.mjs\n\n      - name: Install jsdom for the review desk test\n        run: npm --prefix start-here/tests install --no-audit --no-fund\n\n      # jsdom has to be present for this to mean anything: desk.test.mjs skips\n      # itself when the import fails, and a skip exits zero. Asserting on\n      # skipped and fail counts, rather than a pass count, so adding a case\n      # does not fail the build with a misleading message.\n      - name: The review desk, in a real DOM\n        run: |\n          set -euo pipefail\n          node --test start-here/tests/desk.test.mjs | tee desk.tap\n          grep -q '^# fail 0' desk.tap\n          grep -q '^# skipped 0' desk.tap \\\n            || { echo \"::error::a desk test was skipped; jsdom is probably missing\"; exit 1; }\n          grep -qE '^# pass [1-9]' desk.tap \\\n            || { echo \"::error::no desk test ran at all\"; exit 1; }\n\n  published-wheel:\n    name: From the published package\n    runs-on: ubuntu-latest\n    timeout-minutes: 10\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-python@v5\n        with:\n          python-version: '3.12'\n\n      # Copied outside the repository, so chap_starter.py cannot fall back to\n      # packages/coordinator-py and the installed release is the only CHAP here.\n      - name: Copy the starter out of the checkout\n        run: cp -r start-here \"${RUNNER_TEMP}/start-here\"\n\n      - name: Install the released coordinator\n        run: python -m pip install --upgrade chap-coordinator\n\n      - name: Prove the checkout is not on the import path\n        working-directory: ${{ runner.temp }}/start-here\n        run: |\n          python - <<'PY'\n          import pathlib, sys\n          import chap_coordinator\n          where = pathlib.Path(chap_coordinator.__file__).resolve()\n          print(\"coordinator\", chap_coordinator.__version__, \"from\", where)\n          if \"coordinator-py\" in where.parts:\n              sys.exit(\"the checkout is still on sys.path; this job proves nothing\")\n          PY\n\n      - name: Behaviour tests against the release\n        working-directory: ${{ runner.temp }}/start-here\n        run: python -m unittest discover -s tests -v\n",
