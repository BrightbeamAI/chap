l chap-analytics\n      - name: Git and OpenSSH for the code gate\n        run: |\n          git --version\n          ssh -V\n          git config --global user.name \"CHAP templates CI\"\n          git config --global user.email \"templates-ci@example.invalid\"\n      - name: Generate\n        run: node packages/create-chap-app/index.mjs \"my-${{ matrix.template }}\" --template \"${{ matrix.template }}\" --yes --dir \"${RUNNER_TEMP}/project\"\n      - name: Install the published packages\n        working-directory: ${{ runner.temp }}/project\n        run: npm install --no-audit --no-fund\n      - name: Test\n        working-directory: ${{ runner.temp }}/project\n        run: npm test\n      - name: diff-profiles\n        working-directory: ${{ runner.temp }}/project\n        run: node diff-profiles.mjs --against core/1.0\n\n  python-templates:\n    name: ${{ matrix.template }} on Python ${{ matrix.python }}\n    runs-on: ubuntu-latest\n    needs: generator\n    strategy:\n      fail-fast: false\n      matrix:\n        template: [support-desk, outbound-approval]\n        python: ['3.10', '3.13']\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-node@v4\n        with:\n          node-version: '20'\n      - uses: actions/setup-python@v5\n        with:\n          python-version: ${{ matrix.python }}\n      - name: Generate\n        run: node packages/create-chap-app/index.mjs \"my-${{ matrix.template }}\" --template \"${{ matrix.template }}\" --yes --dir \"${RUNNER_TEMP}/project\"\n      - name: Install the published package\n        working-directory: ${{ runner.temp }}/project\n        run: |\n          python -m pip install --upgrade pip\n          python -m pip install -r requirements.txt pytest chap-analytics\n      - name: Prove the checkout is not on the import path\n        working-directory: ${{ runner.temp }}/project\n        run: |\n          python - <<'PY'\n          import pathlib, sys\n          import chap_coordinator\n        