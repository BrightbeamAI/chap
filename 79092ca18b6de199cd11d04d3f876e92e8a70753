                  "before": "/**\n * @brightbeamai/chap-coordinator/coordinator\n *\n * The Coordinator class. CHAP protocol logic, packaged as a library\n * rather than a CLI server. Applications instantiate one, call\n * `dispatch(envelope)`, subscribe to audit events, and persist via\n * the provided hooks.\n *\n * Coverage:\n *   - Core (9 methods)\n *   - review/1.0 (6 methods)\n *   - whisper/1.0 (2 methods + lapse handling)\n *   - deliberation/1.0 (4 methods)\n *   - modes/1.0 (mode handling at task.create; trial forces review)\n *   - handoff/1.0 (3 methods with multi-task and group support)\n *   - control/1.0 (7 methods with task/participant/workspace scopes)\n *   - routing/1.0 (3 methods producing route_decision artefacts)\n *   - security-signed/1.0 (top-level `sig` field; key history)\n *   - audit-scitt/1.0 (statement assembly + local chain linkage)\n *   - identity-oidc/1.0 + identity-vc/1.0 (binding hooks at join)\n */\n\nimport { canonicalize, contentHash, ZERO_HASH } from \"./canonical.js\";\nimport { ALWAYS_AVAILABLE, OWNING_PROFILE } from \"./catalogue.js\";\nimport { publicKeyFromJwk, verifyEnvelope } from \"./crypto.js\";\nimport { IdFactory } from \"./ids.js\";\nimport { E, isValidEnvelope, rpcError } from \"./jsonrpc.js\";\nimport { entryCall, entryRecord, isSigned, linkHash, refusalIsRecorded, signedDigest } from \"./audit.js\";\nimport { applyJsonPatch } from \"./patch.js\";\nimport type { Store, StoreChange, WorkspaceRecord } from \"./storage/store.js\";\nimport { COLLECTIONS, IDEMPOTENCY_KEYS, MemoryStore } from \"./storage/store.js\";\nimport { TrackedMap, rawEntries, rawValues, type Tracker } from \"./tracked.js\";\nimport { makeApi, type CoordinatorApi } from \"./api.js\";\nimport type {\n  ArtefactId,\n  AuditEntry,\n  AuditListener,\n  Envelope,\n  KeyRecord,\n  Member,\n  Mode,\n  OverrideArtefact,\n  ParticipantUri,\n  SnapshotArtefact,\n  Task,\n  TaskId,\n  Workspace,\n  WorkspaceId,\n} from \"./types.js\";\nimport { modeLE } from \"./types.js\";\nimport { registerAuditScitt } from \"./profiles/audit_scitt.js\";\nimport { registerControl } from \"./profiles/control.js\";\nimport { registerDeliberation } from \"./profiles/deliberation.js\";\nimport { registerHandoff } from \"./profiles/handoff.js\";\nimport { registerRouting } from \"./profiles/routing.js\";\nimport { registerSecuritySigned } from \"./profiles/security_signed.js\";\nimport { registerWhisper } from \"./profiles/whisper.js\";\n\n// ============================================================\n//   Options\n// ============================================================\n\nexport type TokenVerifier = (token: string) => Record<string, unknown> | null;\nexport type CredentialVerifier = (presentation: Record<string, unknown>) => Record<string, unknown> | null;\nexport type ScittSubmitter = (statement: Record<string, unknown>) => Record<string, unknown> | null;\nexport type ScittReceiptVerifier = (receipt: Record<string, unknown>) => boolean;\nexport type RoutingPolicyFn = (task: Task, candidates: ParticipantUri[]) => {\n  selected: ParticipantUri;\n  rationale: Record<string, unknown>;\n};\nexport type ReviewDepthPolicyFn = (task: Task, hints: Record<string, unknown>) => {\n  depth: \"skip\" | \"spot_check\" | \"full\" | \"escalated\";\n  sampling_probability?: number;\n  rationale: Record<string, unknown>;\n};\nexport type EscalationPolicyFn = (task: Task, hints: Record<string, unknown>) => {\n  escalate: boolean;\n  to?: ParticipantUri;\n  triggered_rule?: Record<string, unknown>;\n};\n\n/** Methods classified as privileged for step-up auth. */\nexport const PRIVILEGED_METHODS = new Set<string>([\n  \"control.pause\", \"control.resume\", \"control.cancel\", \"control.supersede\",\n  \"control.snapshot\", \"control.rollback\", \"control.set_mode_ceiling\",\n  \"workspace.set_profiles\",\n  \"participant.rotate_key\", \"participant.revoke_key\",\n]);\n\n// Methods outside the control, deliberate, handoff and whisper namespaces that\n// dispatch holds to the membership floor before the handler runs.\nconst MEMBER_ONLY_METHODS = new Set<string>([\n  \"task.route\", \"review.depth\", \"escalate.auto\", \"participant.leave\",\n]);\n\n// Read-only methods return workspace state but do not mutate it, so they are not\n// recorded in the audit chain -- recording a read would grow and re-link it.\nconst READ_ONLY_METHODS = new Set<string>([\n  \"workspace.describe\", \"audit.read\", \"audit.verify_chain\", \"audit.verify_receipt\",\n  // Submitting the chain to a transparency service reads it and sends it\n  // onward. Recording the submission would append to the very log being\n  // submitted, so the receipt would attest a chain one entry shorter.\n  \"audit.submit_to_scitt\",\n]);\n\n// Cap on a workspace's task.create idempotency map. Older keys are evicted, so\n// the dedup window is bounded rather than growing unbounded in a long-lived\n// workspace; a redelivery beyond this many intervening creates is not deduped.\nconst MAX_IDEMPOTENCY_KEYS = 10_000;\n\n// Largest envelope accepted, published in the workspace descriptor (SPEC S4.4).\nconst DEFAULT_MAX_ENVELOPE_BYTES = 1_048_576;\n\n// How deeply a request may nest, counting the envelope as level one. The\n// reference HTTP servers refuse deeper bodies before dispatch; the same limit\n// here means an in-process caller cannot send what the canonicaliser, the\n// copy of a recorded call and the two references handle differently.\nconst MAX_NESTING = 64;\n\nfunction withinNesting(value: unknown, limit: number): boolean {\n  const stack: Array<[unknown, number]> = [[value, 1]];\n  while (stack.length) {\n    const [node, depth] = stack.pop()!;\n    if (depth > limit) return false;\n    if (Array.isArray(node)) {\n      for (const v of node) stack.push([v, depth + 1]);\n    } else if (node !== null && typeof node === \"object\") {\n      for (const v of Object.values(node as Record<string, unknown>)) stack.push([v, depth + 1]);\n    }\n  }\n  return true;\n}\n\nexport interface CoordinatorOptions {\n  deterministicIds?: boolean;\n  deterministicClock?: boolean;\n  enableChain?: boolean;\n  requireSignatures?: boolean;\n  enforceStepUp?: boolean;\n  requireReadMembership?: boolean;\n  /** Largest envelope accepted (default 1 MiB), published in the descriptor. */\n  maxEnvelopeBytes?: number;\n  onAudit?: AuditListener;\n  onAutoEscalate?: (task: Task, to: ParticipantUri) => void;\n  /**\n   * Called when a write to the store fails, with the workspace and the\n   * version the write would have reached. When unset, the failure is written\n   * to stderr. The call itself has already succeeded in memory; the next\n   * write to the workspace carries what this one did not.\n   */\n  onStoreError?: (err: unknown, record: { id: string; version: number }) => void;\n  verifyOidcToken?: TokenVerifier;\n  verifyVc?: CredentialVerifier;\n  scittSubmitter?: ScittSubmitter;\n  verifyScittReceipt?: ScittReceiptVerifier;\n  routingPolicy?: RoutingPolicyFn;\n  reviewDepthPolicy?: ReviewDepthPolicyFn;\n  escalationPolicy?: EscalationPolicyFn;\n  defaultProfiles?: string[];\n  /**\n   * Persistence backend. Defaults to MemoryStore (no persistence).\n   * Pass SqliteStore or any other Store implementation to persist\n   * workspaces between process restarts. The Coordinator calls\n   * `store.load()` once when it starts, and after each call that adds to a\n   * workspace's log it calls `store.apply()` with what changed, or\n   * `store.save()` with the whole workspace when the store has no `apply`.\n   */\n  store?: Store;\n}\n\n// ============================================================\n//   Helpers\n// ============================================================\n\nfunction nowIso(clockMs?: number): string {\n  const d = clockMs === undefined ? new Date() : new Date(clockMs);\n  return d.toISOString().replace(/\\.(\\d{3})Z$/, \".$1Z\");\n}\n\nfunction missing(params: Record<string, unknown>, fields: string[]): string | null {\n  for (const f of fields) if (!(f in params)) return f;\n  return null;\n}\n\nfunction tagsError(p: Record<string, unknown>): { error: ReturnType<typeof rpcError> } | null {\n  const tags = p.tags;\n  if (tags !== undefined && (!Array.isArray(tags) || !tags.every((t) => typeof t === \"string\"))) {\n    return { error: rpcError(E.PARAMS, \"tags must be a list of strings\") };\n  }\n  return null;\n}\n\nfunction reviewRuleSupported(rule: string): boolean {\n  if (rule === \"any_one_approves\" || rule === \"all_approve\") return true;\n  if (rule.startsWith(\"quorum:\")) {\n    const arg = rule.slice(\"quorum:\".length);\n    return /^[0-9]+$/.test(arg) && parseInt(arg, 10) >= 1;\n  }\n  return false;\n}\n\nfunction reviewSatisfied(review: { requested_to: string[]; rule: string; decisions: { kind: string; reviewer: string }[] }): boolean {\n  const approvers = new Set(review.decisions.filter(d => d.kind === \"approve\").map(d => d.reviewer));\n  const rule = review.rule || \"any_one_approves\";\n  if (rule === \"all_approve\") {\n    // A broadcast-only review has no bounded reviewer set to wait on, so it\n    // degrades to first-approve.\n    const named = review.requested_to.filter(r => !(r.startsWith(\"workspace:\") || r.startsWith(\"group:\")));\n    if (named.length === 0) return approvers.size >= 1;\n    return named.every(r => approvers.has(r));\n  }\n  if (rule.startsWith(\"quorum:\")) return approvers.size >= parseInt(rule.slice(\"quorum:\".length), 10);\n  return approvers.size >= 1;  // any_one_approves (and the default)\n}\n\nfunction reply(env: Envelope, body: { result?: unknown; error?: { code: number; message: string; data?: unknown } }): Envelope {\n  const out: Envelope = { jsonrpc: \"2.0\", id: env.id };\n  if (body.error !== undefined) out.error = body.error;\n  else out.result = body.result;\n  return out;\n}\n\n/** The signed calls on a log, keyed by `signedDigest`. */\ninterface SignedIndex {\n  refused: Map<string, { seq: number; code: number }>;\n  accepted: Set<string>;\n}\n\nfunction indexSigned(index: SignedIndex, entry: AuditEntry): void {\n  const call = entryCall(entry);\n  if (!isSigned(call)) return;\n  let digest: string;\n  try { digest = signedDigest(call as Envelope); }\n  catch { return; /* an entry that cannot be canonicalised was altered; verify_chain reports it */ }\n  if (entry.outcome != null) index.refused.set(digest, { seq: entry.seq, code: entry.outcome.code });\n  else index.accepted.add(digest);\n}\n\n// ============================================================\n//   Handler type for profile modules\n// ============================================================\n\nexport type Handler = (params: Record<string, unknown>) => { result?: unknown; error?: { code: number; message: string; data?: unknown } };\n\n// ============================================================\n//   Coordinator\n// ============================================================\n\nfunction isThenable(value: unknown): value is PromiseLike<void> {\n  return typeof (value as PromiseLike<void> | undefined)?.then === \"function\";\n}\n\n/** A deep copy where the value can be cloned, else the value itself. */\nfunction ownCopy<T>(value: T): T {\n  try {\n    return structuredClone(value);\n  } catch {\n    return value;\n  }\n}\n\n// States in which a task has been deliberately stopped. review.request and\n// task.complete both refuse these, so neither can revive a terminated task nor\n// bypass a pause.\nconst REVIEW_REQUEST_STOPPED: string[] = [\"cancelled\", \"superseded\", \"paused\"];\n\n/** What the store holds of one workspace, as far as a Coordinator knows. */\ninterface Persisted {\n  /** Audit entries the store holds. */\n  seq: number;\n  /** Write the whole workspace next: the store's copy is unknown. */\n  replace: boolean;\n  /** Idempotency keys written or removed since the last write. */\n  keys: Set<string>;\n  /** The time to stamp on the next write. */\n  updatedAt?: string;\n}\n\nexport class Coordinator {\n  readonly workspaces = new Map<WorkspaceId, Workspace>();\n  readonly options: CoordinatorOptions;\n  readonly ids: IdFactory;\n  readonly store: Store;\n  private wsVersions = new Map<WorkspaceId, number>();\n  private saveChains = new Map<WorkspaceId, Promise<void>>();\n  /** Records which objects change, for stores that implement `apply`. */\n  private readonly tracker: Tracker;\n  /** What the store holds of each workspace, as far as this instance knows. */\n  private persisted = new WeakMap<Workspace, Persisted>();\n  /** Workspaces with entries not yet written in the call being handled. */\n  private unflushed = new Set<Workspace>();\n  /** Workspaces with a write queued behind an async write in flight. */\n  private flushQueued = new Set<Workspace>();\n  private clockMs?: number;\n  private frozenNow?: string;\n  private auditListeners: AuditListener[] = [];\n  /**\n   * The signed calls on each workspace's log, by what their senders signed:\n   * recorded refusals with their seq and code, and accepted calls. Rebuilt\n   * from the log when missing, so a snapshot never carries it.\n   */\n  private signedIndexes = new WeakMap<Workspace, SignedIndex>();\n  /** Method handler registry; profiles plug into this. */\n  readonly handlers = new Map<string, Handler>();\n  /** Custom lapse-check function (whisper/1.0). Set by the whisper profile. */\n  checkWhisperLapses?: (workspaceId: string, now?: string) => Envelope[];\n  /** Typed method facade. Defined via getter in the constructor. */\n  readonly api!: CoordinatorApi;\n  /** @internal cached facade instance */\n  private _api?: CoordinatorApi;\n\n  constructor(options: CoordinatorOptions = {}) {\n    this.options = options;\n    this.store = options.store ?? new MemoryStore();\n    this.tracker = { enabled: typeof this.store.apply === \"function\", depth: 0 };\n    this.ids = new IdFactory(!!options.deterministicIds, 0n, 1_700_000_000_000);\n    if (options.deterministicClock) this.clockMs = 1_700_000_000_000;\n    if (options.onAudit) this.auditListeners.push(options.onAudit);\n\n    this.registerCoreHandlers();\n    this.registerProfileHandlers();\n\n    // Lazily-initialised typed facade. Constructed on first access so\n    // tests that don't use it pay nothing.\n    Object.defineProperty(this, \"api\", {\n      get: () => {\n        if (!this._api) this._api = makeApi(this);\n        return this._api;\n      },\n      enumerable: false,\n      configurable: true,\n    });\n\n    // Rehydrate any persisted state synchronously. Async stores can\n    // call `start()` instead; this fallback covers the common\n    // synchronous Memory/Sqlite path with no async setup needed.\n    try {\n      const loaded = this.store.load();\n      if (!isThenable(loaded)) {\n        this.applyRecords(loaded as WorkspaceRecord[]);\n      }\n    } catch {\n      /* fall through; caller must invoke start() */\n    }\n  }\n\n  /**\n   * Asynchronously hydrate workspaces from the store. Required only for\n   * stores whose `load()` returns a Promise. Idempotent.\n   */\n  async start(): Promise<void> {\n    const records = await this.store.load();\n    this.applyRecords(records);\n  }\n\n  private applyRecords(records: WorkspaceRecord[]): void {\n    // One restore for every record: restore replaces the workspaces it\n    // holds, so restoring record by record kept only the last.\n    this.wsVersions.clear();\n    this.restore(records.map(r => r.data));\n    for (const r of records) this.wsVersions.set(r.id, r.version);\n    // What was just loaded is what the store holds.\n    for (const ws of this.workspaces.values()) this.markWritten(ws);\n  }\n\n  /** A map for a workspace collection, tracked for stores that implement `apply`. */\n  private newMap<K, V>(): Map<K, V> {\n    return new TrackedMap<K, V>(this.tracker);\n  }\n\n  /** Record that the store holds this workspace exactly as it is in memory. */\n  private markWritten(ws: Workspace): void {\n    for (const name of COLLECTIONS) {\n      const map = ws[name];\n      if (map instanceof TrackedMap) map.dirty.clear();\n    }\n    this.persisted.set(ws, { seq: ws.audit.length, replace: false, keys: new Set() });\n  }\n\n  /**\n   * What the store holds of a workspace. A workspace this instance did not\n   * create or load, such as one an application put in `workspaces` itself,\n   * or one whose maps an application replaced, is tracked from here on and\n   * written whole once.\n   */\n  private persistedOf(ws: Workspace): Persisted {\n    let p = this.persisted.get(ws);\n    let untracked = false;\n    for (const name of COLLECTIONS) {\n      const map = ws[name] as Map<string, unknown>;\n      if (map instanceof TrackedMap && map.tracker === this.tracker) continue;\n      untracked = true;\n      const tracked = new TrackedMap<string, unknown>(this.tracker);\n      for (const [key, value] of Map.prototype.entries.call(map) as IterableIterator<[string, unknown]>) {\n        tracked.set(key, value);\n      }\n      (ws as unknown as Record<string, unknown>)[name] = tracked;\n    }\n    if (!p || untracked) {\n      p = { seq: p?.seq ?? 0, replace: true, keys: new Set(), updatedAt: p?.updatedAt };\n      this.persisted.set(ws, p);\n    }\n    return p;\n  }\n\n  /** Record that a task.create idempotency key was written or removed. */\n  private markKey(ws: Workspace, key: string): void {\n    if (this.tracker.enabled) this.persistedOf(ws).keys.add(key);\n  }\n\n  /** After an entry is appended: write now, or when the call being handled ends. */\n  private persist(ws: Workspace): void {\n    if (!this.tracker.enabled) {\n      this.persistSnapshot(ws);\n      return;\n    }\n    // One clock reading per entry, where earlier releases read it to stamp\n    // the snapshot, so a deterministic clock gives the same times as before.\n    this.persistedOf(ws).updatedAt = this.now();\n    if (this.tracker.depth > 0) this.unflushed.add(ws);\n    else this.flush(ws);\n  }\n\n  private flushUnflushed(): void {\n    if (!this.unflushed.size) return;\n    const list = [...this.unflushed];\n    this.unflushed.clear();\n    for (const ws of list) this.flush(ws);\n  }\n\n  /** Write what changed in one workspace since its last write. */\n  private flush(ws: Workspace): void {\n    const pending = this.saveChains.get(ws.id);\n    if (pending) {\n      // An async write is in flight. One more write follows it, built when it\n      // runs, so it carries everything that changed until then.\n      if (this.flushQueued.has(ws)) return;\n      this.flushQueued.add(ws);\n      this.chainWrite(ws.id, pending.then(() => {\n        this.flushQueued.delete(ws);\n        return this.writeChange(ws);\n      }));\n      return;\n    }\n    const result = this.writeChange(ws);\n    if (result) this.chainWrite(ws.id, result);\n  }\n\n  private chainWrite(id: WorkspaceId, work: Promise<void>): void {\n    // writeChange reports its own failures; this only keeps the chain alive.\n    const guarded = work.catch(() => undefined);\n    this.saveChains.set(id, guarded);\n    void guarded.then(() => {\n      if (this.saveChains.get(id) === guarded) this.saveChains.delete(id);\n    });\n  }\n\n  private writeChange(ws: Workspace): Promise<void> | void {\n    const p = this.persistedOf(ws);\n    let change: StoreChange | undefined;\n    try {\n      change = this.takeChange(ws, p);\n    } catch (err) {\n      // What was taken is unknown, so the next write carries the whole workspace.\n      p.replace = true;\n      this.reportStoreError(err, { id: ws.id, version: ws.audit.length });\n      return;\n    }\n    if (!change) return;\n    const taken = change;\n    const done = () => {\n      p.seq = taken.version;\n      if (taken.replace) p.replace = false;\n    };\n    const failed = (err: unknown) => {\n      this.giveBack(ws, p, taken);\n      this.reportStoreError(err, { id: taken.id, version: taken.version });\n    };\n    let result: PromiseLike<void> | void;\n    try {\n      result = this.store.apply!(taken);\n    } catch (err) {\n      failed(err);\n      return;\n    }\n    if (isThenable(result)) return Promise.resolve(result).then(done, failed);\n    done();\n  }\n\n  /** The change since the last write, taking the recorded keys with it. */\n  private takeChange(ws: Workspace, p: Persisted): StoreChange | undefined {\n    const replace = p.replace;\n    const objects: Record<string, Record<string, unknown>> = {};\n    for (const name of COLLECTIONS) {\n      const map = ws[name] as unknown as TrackedMap<string, unknown>;\n      if (replace) {\n        const all: Record<string, unknown> = {};\n        for (const [key, value] of Map.prototype.entries.call(map) as IterableIterator<[string, unknown]>) {\n          all[key] = value;\n        }\n        objects[name] = all;\n      } else if (map.dirty.size) {\n        const changed: Record<string, unknown> = {};\n        for (const key of map.dirty) changed[key] = map.peek(key) ?? null;\n        objects[name] = changed;\n      }\n      map.dirty.clear();\n    }\n    if (replace) {\n      objects[IDEMPOTENCY_KEYS] = { ...ws.idempotency_keys };\n    } else if (p.keys.size) {\n      const changed: Record<string, unknown> = {};\n      for (const key of p.keys) changed[key] = ws.idempotency_keys[key] ?? null;\n      objects[IDEMPOTENCY_KEYS] = changed;\n    }\n    p.keys.clear();\n    const entries = ws.audit.slice(replace ? 0 : p.seq);\n    if (!replace && !entries.length && !Object.keys(objects).length) return undefined;\n    return {\n      id: ws.id,\n      base: replace ? 0 : p.seq,\n      version: ws.audit.length,\n      updated_at: p.updatedAt ?? ws.audit[ws.audit.length - 1]?.arrived ?? ws.created,\n      meta: this.metaOf(ws),\n      entries,\n      objects,\n      ...(replace ? { replace: true } : {}),\n    };\n  }\n\n  /** A failed write's keys go back, so the next write carries them again. */\n  private giveBack(ws: Workspace, p: Persisted, change: StoreChange): void {\n    if (change.replace) {\n      p.replace = true;\n      return;\n    }\n    for (const [name, items] of Object.entries(change.objects)) {\n      if (name === IDEMPOTENCY_KEYS) {\n        for (const key of Object.keys(items)) p.keys.add(key);\n        continue;\n      }\n      const map = (ws as unknown as Record<string, unknown>)[name];\n      if (map instanceof TrackedMap) for (const key of Object.keys(items)) map.dirty.add(key);\n    }\n  }\n\n  /** Persist the whole workspace, for a store that implements only `save`. */\n  private persistSnapshot(ws: Workspace): void {\n    const next = (this.wsVersions.get(ws.id) ?? 0) + 1;\n    this.wsVersions.set(ws.id, next);\n    let record: WorkspaceRecord;\n    try {\n      record = { id: ws.id, data: this.snapshotOf(ws), version: next, updated_at: this.now() };\n    } catch {\n      return;\n    }\n\n    const pending = this.saveChains.get(ws.id);\n    if (pending) {\n      this.trackSave(pending.then(() => this.store.save(record)), record);\n      return;\n    }\n    let result: PromiseLike<void> | void;\n    try {\n      result = this.store.save(record);\n    } catch (err) {\n      this.reportStoreError(err, record);\n      return;\n    }\n    if (isThenable(result)) {\n      this.trackSave(Promise.resolve(result), record);\n    }\n  }\n\n  private trackSave(save: Promise<void>, record: WorkspaceRecord): void {\n    const guarded = save.catch(err => this.reportStoreError(err, record));\n    this.saveChains.set(record.id, guarded);\n    void guarded.then(() => {\n      if (this.saveChains.get(record.id) === guarded) {\n        this.saveChains.delete(record.id);\n      }\n    });\n  }\n\n  private reportStoreError(err: unknown, record: { id: string; version: number }): void {\n    if (this.options.onStoreError) {\n      try {\n        this.options.onStoreError(err, { id: record.id, version: record.version });\n      } catch {\n        void 0;\n      }\n      return;\n    }\n    const message = err instanceof Error ? err.message : String(err);\n    console.error(`chap coordinator: writing workspace ${record.id} to the store failed: ${message}`);\n  }\n\n  async drainSaves(): Promise<void> {\n    while (this.saveChains.size) {\n      await Promise.allSettled([...this.saveChains.values()]);\n    }\n  }\n\n  // -- lifecycle -----------------------------------------------------\n\n  private advanceClock(): string {\n    if (this.clockMs !== undefined) {\n      this.clockMs += 1000;\n      return nowIso(this.clockMs);\n    }\n    return nowIso();\n  }\n\n  now(): string {\n    return this.frozenNow ?? this.advanceClock();\n  }\n\n  onAudit(listener: AuditListener): () => void {\n    this.auditListeners.push(listener);\n    return () => {\n      const i = this.auditListeners.indexOf(listener);\n      if (i >= 0) this.auditListeners.splice(i, 1);\n    };\n  }\n\n  /** Convenience: get a workspace by id, or undefined. */\n  getWorkspace(id: WorkspaceId): Workspace | undefined {\n    return this.workspaces.get(id);\n  }\n\n  // ----- authorisation preconditions -----\n\n  /**\n   * Assert that `sender` is a joined member of `ws`. Returns an error\n   * fragment if not, else null. Every actor-action method runs this on\n   * its `from` so a decision, completion, or review request can never\n   * be attributed to a participant who never joined. See\n   * SPECIFICATION.md S6.3 and the `unknown_participant` condition in\n   * S13.3. (The published spec assigns -32403; the reference\n   * implementations use NOT_AUTHORISED -32011 because -32403 already\n   * denotes OIDC_TOKEN_INVALID in their private range. The spec/impl\n   * error-table divergence is tracked separately.)\n   */\n  private requireMember(ws: Workspace, sender: unknown): { error: ReturnType<typeof rpcError> } | null {\n    // A `from` that is not a string names nobody. It is answered in fixed\n    // words, so both references refuse it alike whatever was sent.\n    if (typeof sender !== \"string\") {\n      return { error: rpcError(E.NOT_AUTHORISED, \"Not a workspace member: from is not a participant URI\") };\n    }\n    if (!ws.members.has(sender)) {\n      return { error: rpcError(E.NOT_AUTHORISED, `Not a workspace member: ${sender}`) };\n    }\n    return null;\n  }\n\n  /**\n   * Assert that `sender` was addressed in the task's review. Applied to\n   * review-decision methods (decide.* and abstain.declare): to act on a\n   * review you must be one of the reviewers it was addressed to (the\n   * `to` set on review.request). Membership is the floor; this is the\n   * eligibility ceiling for decisions. Returns an error fragment if not\n   * eligible, else null.\n   */\n  private requireReviewer(task: Task, sender: unknown): { error: ReturnType<typeof rpcError> } | null {\n    const review = task.review;\n    if (!review || !review.requested_to || review.requested_to.length === 0) {\n      // No recorded reviewer set: fall back to the membership floor,\n      // which the caller has already enforced.\n      return null;\n    }\n    // A broadcast-scoped reviewer (workspace:/group: URI) is satisfied by\n    // any workspace member; the membership floor already passed. Note the\n    // coordinator does not model group membership: a group: target means\n    // \"any member\", not \"any member of that group\" (deployments needing\n    // true group restriction enforce it externally). Keeps the documented\n    // `to: workspace:<id>` broadcast pattern working.\n    if (review.requested_to.some((r) => typeof r === \"string\" && (r.startsWith(\"workspace:\") || r.startsWith(\"group:\")))) {\n      return null;\n    }\n    if (typeof sender !== \"string\" || !review.requested_to.includes(sender as ParticipantUri)) {\n      return { error: rpcError(E.NOT_AUTHORISED, `Not an addressed reviewer for this task: ${String(sender)}`) };\n    }\n    return null;\n  }\n\n  /** Serialise all workspaces to a JSON-safe structure for persistence. */\n  snapshot(): unknown {\n    const out: Array<Record<string, unknown>> = [];\n    for (const ws of this.workspaces.values()) out.push(this.snapshotOf(ws));\n    return out;\n  }\n\n  /** The workspace's own fields: everything except its collections and log. */\n  private metaOf(ws: Workspace): Record<string, unknown> {\n    return {\n      id:           ws.id,\n      created:      ws.created,\n      state:        ws.state,\n      profiles:     ws.profiles,\n      mode:         ws.mode,\n      mode_ceiling: ws.mode_ceiling,\n      routing_policy_uri: ws.routing_policy_uri,\n      step_up_window_sec: ws.step_up_window_sec,\n      min_acr:      ws.min_acr,\n      chain_head:   ws.chain_head,\n      chain_enabled: ws.chain_enabled,\n    };\n  }\n\n  /** One workspace as `snapshot()` holds it. Reads nothing as a change. */\n  private snapshotOf(ws: Workspace): Record<string, unknown> {\n    const { chain_head, chain_enabled, ...own } = this.metaOf(ws);\n    return {\n      ...own,\n      members:         Array.from(rawValues(ws.members)),\n      tasks:           Array.from(rawValues(ws.tasks)),\n      overrides:       Array.from(rawValues(ws.overrides)),\n      whispers:        Array.from(rawValues(ws.whispers)),\n      deliberations:   Array.from(rawValues(ws.deliberations)),\n      handoffs:        Array.from(rawValues(ws.handoffs)),\n      snapshots:       Array.from(rawValues(ws.snapshots)),\n      route_decisions: Array.from(rawValues(ws.route_decisions)),\n      idempotency_keys: { ...ws.idempotency_keys },\n      audit:           ws.audit,\n      chain_head,\n      chain_enabled,\n    };\n  }\n\n  /** Restore from a snapshot produced by ``snapshot()``. Replaces\n   *  any existing in-memory workspaces. */\n  restore(data: unknown): void {\n    this.workspaces.clear();\n    this.unflushed.clear();\n    if (!Array.isArray(data)) return;\n    for (const w of data as Array<Record<string, unknown>>) {\n      // One workspace that cannot be rebuilt is skipped, with a warning, so\n      // the others still load.\n      let ws: Worksp