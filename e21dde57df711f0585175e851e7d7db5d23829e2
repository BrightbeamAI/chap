ht\":{\"step\":44},\"encoding\":{\"x\":{\"field\":\"x\",\"type\":\"ordinal\",\"axis\":null},\"y\":{\"field\":\"lane\",\"type\":\"nominal\",\"title\":null,\"sort\":null}},\"layer\":[{\"mark\":{\"type\":\"line\",\"color\":\"#bbbbbb\",\"strokeWidth\":1,\"interpolate\":\"monotone\"},\"encoding\":{\"detail\":{\"field\":\"node\"},\"order\":{\"field\":\"x\"}}},{\"mark\":{\"type\":\"circle\",\"size\":260,\"stroke\":\"white\",\"strokeWidth\":1.5},\"encoding\":{\"color\":{\"field\":\"kind\",\"type\":\"nominal\",\"title\":null,\"scale\":{\"domain\":[\"human\",\"agent\",\"service\",\"group\"],\"range\":[\"#c0392b\",\"#1f4e79\",\"#8a8f98\",\"#7d6608\"]}},\"tooltip\":[{\"field\":\"when\",\"type\":\"temporal\",\"title\":\"when\"},{\"field\":\"lane\",\"title\":\"who\"},{\"field\":\"action\"},{\"field\":\"node_type\"},{\"field\":\"label\"}]}},{\"mark\":{\"type\":\"text\",\"dy\":-18,\"fontSize\":10,\"color\":\"#333333\"},\"encoding\":{\"text\":{\"field\":\"action\"}}}]}},\"questions\":{\"rate_over_time\":{\"question\":\"How often do reviewers change the agent's output, and is that moving?\",\"decision\":\"A rising band is a prompt or model change to look at; a wide band is a period with too few decisions to read.\"},\"rate_by_kind\":{\"question\":\"Does the override rate differ by kind?\",\"decision\":\"Groups whose whiskers sit apart differ; groups whose whiskers overlap are within noise at this sample.\"},\"rate_by_reviewer\":{\"question\":\"Does the override rate differ by reviewer?\",\"decision\":\"Groups whose whiskers sit apart differ; groups whose whiskers overlap are within noise at this sample.\"},\"refine_reverse\":{\"question\":\"When reviewers correct the agent, are they refining its decision or reversing it?\",\"decision\":\"A high refining share points at the prompt or the wording; a high reversing share points at the policy or the task context.\"},\"patch_heatmap\":{\"question\":\"Where in the artefact do the corrections land?\",\"decision\":\"The darkest cell names the field and the task kind to fix first. Click through to the rationales behind it.\"},\"reliability\":{\"question\":\"Does the agent's reported confidence track how often reviewers accept its work?\",\"decision\":\"Points below the diagonal are overconfidence: lower the routing threshold there. Above it, the agent undersells itself.\"},\"survival\":{\"question\":\"How long does a review wait for its first decision, and how much is still waiting?\",\"decision\":\"A curve that flattens above zero is a queue that does not clear: add reviewers or reroute that kind of work.\"},\"latency_by_reviewer\":{\"question\":\"Who is the work waiting on, by reviewer?\",\"decision\":\"A long median is load; a long 90th percentile with a short median is a few stuck items. They want different fixes.\"},\"promotion\":{\"question\":\"Is this agent's rate of substantive correction below the bar, given what has been seen?\",\"decision\":\"Promote when nearly all of the curve sits left of the line. A wide curve says the answer is still mostly prior.\"},\"sequential\":{\"question\":\"Has enough been seen to promote or to hold?\",\"decision\":\"Crossing the lower bound says promote; the upper says hold. Between them, keep collecting.\"},\"agreement\":{\"question\":\"Do reviewers agree with each other on the same artefact?\",\"decision\":\"A pair with low kappa on many shared passes points at an ambiguous policy or a difference in standard worth talking about.\"},\"whispers\":{\"question\":\"How often do agents have to ask, and does anyone answer in time?\",\"decision\":\"A high lapse rate is a question the task input should have answered, or a reviewer who is never at the desk.\"},\"handoffs\":{\"question\":\"Are handoffs accepted, and by whom?\",\"decision\":\"A recipient who declines often, or takes long to answer, is a gap in the shift plan.\"},\"assurance\":{\"question\":\"Is the record verifiable end to end?\",\"decision\":\"Every line at 100% is a chain a third party can check. A dip is a period whose entries carry less than the rest.\"},\"cusum\":{\"question\":\"Has the correction rate moved since the last prompt or model change?\",\"decision\":\"An alarm names the task at which the accumulated evidence crossed the line. Look at what changed just before it.\"},\"collaboration\":{\"question\":\"Who does most of the reviewing, and does one person decide most of one agent's work?\",\"decision\":\"A thick line into one agent from one reviewer is concentration. A node every line passes through is a bottleneck.\"},\"lineage\":{\"question\":\"What led to this outcome, and who was involved at each step?\",\"decision\":\"Read left to right. Every point is an envelope on the chain; a human lane with no point on it is a step nobody signed off.\"}},\"briefs\":[{\"name\":\"overrides\",\"title\":\"How often the agent's work is changed\",\"headline\":\"Reviewers changed 32% of 414 decided tasks: 32% corrected (28% to 37%) and 0% sent back.\",\"text\":\"68% of the agent's work went out as drafted. Of the corrections that said which, 57% refined the agent's decision and 43% reversed it (77 against 57, 0 unstated).\",\"decision\":\"Corrections split between wording and substance: look at the tags and paths to separate them.\",\"sufficient\":true,\"numbers\":{\"n\":414,\"override_rate\":0.32367149758454106,\"reject_rate\":0.0}},{\"name\":\"paths\",\"title\":\"Where the corrections land\",\"headline\":\"The most corrected part of the artefact is reply in classification tasks: 21 of 52 corrections of that kind (40%).\",\"text\":\"Across 3 task kinds, corrections touch 4 distinct parts of the artefact. The heatmap ranks them per kind, and the rationales behind any cell are one call away.\",\"decision\":\"Start with the prompt section that produces reply for classification.\",\"sufficient\":true,\"numbers\":{\"top_path\":\"reply\",\"task_kind\":\"classification\",\"share\":0.40384615384615385}},{\"name\":\"calibration\",\"title\":\"Whether confidence can be trusted\",\"headline\":\"Expected calibration error 0.09 over 414 tasks; Brier score 0.21.\",\"text\":\"The agent is overconfident: at a reported 86% reviewers accepted 75% (83 tasks). Its stated confidence runs ahead of its record.\",\"decision\":\"Set routing thresholds from the observed acceptance at each confidence level rather than the reported number.\",\"sufficient\":true,\"numbers\":{\"n\":414,\"ece\":0.08811594202898551,\"brier\":0.20692173913043477}},{\"name\":\"promotion\",\"title\":\"Whether an agent is ready to promote\",\"headline\":\"agent:drafter: 57 substantive corrections in 414 decided tasks, true rate 11% to 17% (90% credible), 1% chance it is under 10%.\",\"text\":\"The bar is a substantive correction rate under 10%: overrides that reversed the agent's decision plus rejections, out of decided tasks. With 414 decided tasks the posterior is well pinned down.\",\"decision\":\"Hold. Either the rate is above the bar or too few tasks have been decided to say.\",\"sufficient\":true,\"numbers\":{\"threshold\":0.1}},{\"name\":\"latency\",\"title\":\"How long decisions take\",\"headline\":\"Half of the reviews were decided within 1.0 hours, nine in ten within 3.9 hours; 6 still waiting.\",\"text\":\"414 review passes reached a decision. The oldest open review has waited 1.9 hours. human:ana takes longest at a median of 1.2 hours; human:ben is quickest at 57 minutes.\",\"decision\":\"Decisions are keeping up with the work.\",\"sufficient\":true,\"numbers\":{\"median_s\":3614.0,\"p90_s\":13936.8,\"open\":6}},{\"name\":\"agreement\",\"title\":\"Whether reviewers agree\",\"headline\":\"On 77 passes two reviewers decided, kappa is -0.07 (observed agreement 87%).\",\"text\":\"These are passes a first reviewer accepted, since a correction settles a pass; kappa here says how often the next reviewer agreed with an acceptance. The pair that agrees least is human:ben and human:cal (kappa -0.07 over 26 passes).\",\"decision\":\"Reviewers agree on nearly every shared pass. Kappa is low only because almost all of those passes are acceptances, which leaves little disagreement to measure.\",\"sufficient\":true,\"numbers\":{}},{\"name\":\"whispers\",\"title\":\"Whether agents get answers\",\"headline\":\"71 questions asked, 19 lapsed (27%, 18% to 38%); answers took a median of 8 minutes.\",\"text\":\"That is one question per 6 tasks.\",\"decision\":\"A quarter or more lapse: the default answer is deciding those tasks. Put the answer in the task input, or route whispers to whoever is at the desk.\",\"sufficient\":true,\"numbers\":{}},{\"name\":\"handoffs\",\"title\":\"Whether handoffs are accepted\",\"headline\":\"10 handoffs proposed, 9 accepted (90%, 60% to 98%), 1 declined, 0 open; resolved in a median of 26 minutes.\",\"text\":\"human:cal accepts least (80% of 5).\",\"decision\":\"Work moves between people when it needs to.\",\"sufficient\":true,\"numbers\":{}},{\"name\":\"assurance\",\"title\":\"Whether the record holds up\",\"headline\":\"1929 entries: 100% hash-linked, 0% signed, 0% submitted to a transparency log.\",\"text\":\"Every hash-linked entry can be checked against its predecessor by anyone holding the log. A signed entry can be checked against its sender's key. A submitted entry has a receipt a third party can verify.\",\"decision\":\"The chain is tamper-evident. Turn on signing for non-repudiation and SCITT submission for independent timestamps.\",\"sufficient\":true,\"numbers\":{\"n\":1929,\"chained\":1929,\"signed\":0,\"scitt_submitted\":0}},{\"name\":\"drift\",\"title\":\"Whether the correction rate has moved\",\"headline\":\"No alarm over 414 decided tasks; the correction rate has stayed near 36% (now 32% cumulative).\",\"text\":\"The chart is tuned to notice a rise from 36% to 46%, and to raise a false alarm about once in every 1000 tasks when nothing has changed.\",\"decision\":\"Nothing has moved. Keep the chart running.\",\"sufficient\":true,\"numbers\":{\"alarms\":0}},{\"name\":\"concentration\",\"title\":\"Who carri