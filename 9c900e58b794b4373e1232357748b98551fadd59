ding: 1.25rem .9rem; color: var(--muted); font-size: var(--text-s); }\n\n.main { min-width: 0; min-height: 0; display: flex; flex-direction: column; overflow: hidden; }\n.tabs { display: flex; gap: 2px; padding: .5rem 1.125rem 0; border-bottom: 1px solid var(--line); background: var(--panel); }\n.tab { padding: .6rem .9rem; border: 0; border-bottom: 2px solid transparent; background: none; color: var(--muted); font-weight: 550; font-size: var(--text-s); white-space: nowrap; border-radius: 6px 6px 0 0; }\n.tab:hover { color: var(--ink); background: var(--panel-2); }\n.tab[aria-selected=\"true\"] { color: var(--ink); border-bottom-color: var(--accent); }\n.tab .badge { margin-left: 6px; }\n.view { overflow: auto; padding: 1.25rem; flex: 1; }\n.view[hidden] { display: none; }\n\n/* -- pieces ------------------------------------------------------------- */\n.card { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); }\n.card .card-head { display: flex; align-items: center; gap: .65rem; padding: .75rem 1.125rem; border-bottom: 1px solid var(--line); }\n.card .card-body { padding: 1rem 1.125rem; overflow-x: auto; }\n.badge { display: inline-block; padding: .125rem .55rem; border-radius: 999px; font-size: var(--text-xs); font-weight: 600; letter-spacing: .005em; background: var(--panel-2); color: var(--ink-2); border: 1px solid var(--line); white-space: nowrap; }\n.badge.ok { background: var(--ok-soft); color: var(--ok); border-color: transparent; }\n.badge.warn { background: var(--warn-soft); color: var(--warn); border-color: transparent; }\n.badge.bad { background: var(--bad-soft); color: var(--bad); border-color: transparent; }\n.badge.accent { background: var(--accent-soft); color: var(--accent); border-color: transparent; }\n.btn { display: inline-flex; align-items: center; gap: .45rem; padding: .5rem 1rem; border-radius: var(--radius-s); border: 1px solid var(--line-strong); background: var(--panel); font-