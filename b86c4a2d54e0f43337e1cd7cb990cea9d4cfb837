                  "before": "name: 'CHAP Conformance'\ndescription: 'Run the CHAP conformance harness against an HTTP CHAP coordinator endpoint and fail the job if any vector does not match.'\nauthor: 'Brightbeam AI'\nbranding:\n  icon: 'check-circle'\n  color: 'orange'\n\ninputs:\n  url:\n    description: \"URL of the CHAP coordinator endpoint to test against (e.g. http://localhost:8080/chap). The endpoint must accept JSON-RPC 2.0 POSTs.\"\n    required: true\n  ref:\n    description: \"Git ref of the BrightbeamAI/chap repository to source the harness from. Defaults to the release this action ships in.\"\n    required: false\n    default: 'v0.3.0'\n  core-only:\n    description: \"Set to 'true' to run the Core vectors alone, for a coordinator that does not implement review/1.0. By default the harness runs the Core and review/1.0 vectors.\"\n    required: false\n    default: 'false'\n  node-version:\n    description: \"Node version to use.\"\n    required: false\n    default: '20'\n\noutputs:\n  passed:\n    description: \"Number of vectors that passed.\"\n    value: ${{ steps.harness.outputs.passed }}\n  failed:\n    description: \"Number of vectors that failed.\"\n    value: ${{ steps.harness.outputs.failed }}\n\nruns:\n  using: 'composite'\n  steps:\n    - name: Set up Node\n      uses: actions/setup-node@v4\n      with:\n        node-version: ${{ inputs.node-version }}\n\n    - name: Check out CHAP conformance harness\n      uses: actions/checkout@v4\n      with:\n        repository: BrightbeamAI/chap\n        ref: ${{ inputs.ref }}\n        path: .chap-conformance\n        sparse-checkout: |\n          conformance\n          schemas\n          packages/coordinator/src\n\n    - name: Install harness deps\n      shell: bash\n      run: |\n        cd .chap-conformance/conformance/harness\n        npm install --no-audit --no-fund\n\n    - name: Run conformance harness\n      id: harness\n      shell: bash\n      env:\n        CHAP_URL: ${{ inputs.url }}\n        CHAP_CORE_ONLY: ${{ inputs.core-only }}\n      run: |\n        cd .chap-conformance/conformance/harness\n        set +e\n        args=(--url=\"${CHAP_URL}\")\n        if [ \"${CHAP_CORE_ONLY}\" = \"true\" ]; then args+=(--core-only); fi\n        npx tsx harness.ts \"${args[@]}\" | tee harness-output.txt\n        rc=${PIPESTATUS[0]}\n        set -e\n\n        # The harness ends with \"All N tests passed.\" or \"F of T tests failed.\"\n        summary=$(grep -oE '[0-9]+ of [0-9]+ tests failed' harness-output.txt | tail -1 || true)\n        if [ -n \"$summary\" ]; then\n          failed=${summary%% of *}\n          total=$(echo \"$summary\" | grep -oE 'of [0-9]+' | grep -oE '[0-9]+')\n          passed=$((total - failed))\n        else\n          passed=$(grep -oE '[0-9]+ tests passed' harness-output.txt | tail -1 | grep -oE '[0-9]+' || echo 0)\n          failed=0\n        fi\n        echo \"passed=$passed\" >> \"$GITHUB_OUTPUT\"\n        echo \"failed=$failed\" >> \"$GITHUB_OUTPUT\"\n\n        if [ \"$rc\" -eq 2 ]; then\n          echo \"::error::The conformance harness could not run (exit code 2). Check the url input and that the endpoint answers JSON-RPC.\"\n          exit 2\n        fi\n        if [ \"$rc\" -ne 0 ]; then\n          echo \"::error::Conformance harness failed: $failed of $((passed + failed)) vector(s) did not match.\"\n          exit \"$rc\"\n        fi\n",
