{
  "name": "@brightbeamai/chap-code-gate",
  "version": "0.3.5",
  "description": "The CHAP code gate: every change a coding agent makes is proposed as a patch, reviewed as a diff, signed by a person and committed only once approved, with the evidence beside the commit, git hooks, and a verifier for CI.",
  "license": "Apache-2.0",
  "author": "Brightbeam AI <oss@brightbeam.com>",
  "homepage": "https://github.com/BrightbeamAI/chap/tree/main/packages/chap-code-gate",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrightbeamAI/chap.git",
    "directory": "packages/chap-code-gate"
  },
  "bugs": {
    "url": "https://github.com/BrightbeamAI/chap/issues"
  },
  "keywords": [
    "chap",
    "human-in-the-loop",
    "code-review",
    "git-hooks",
    "coding-agent",
    "audit"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "chap-code-gate": "bin/chap-code-gate.mjs"
  },
  "files": [
    "bin",
    "lib",
    "index.mjs",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./index.mjs",
    "./*": "./lib/*.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@brightbeamai/chap-server": "^0.3.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
