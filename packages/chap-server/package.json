{
  "name": "@brightbeamai/chap-server",
  "version": "0.3.4",
  "description": "The server a CHAP project runs: the review desk, CHAP calls at POST /chap, the read API, the analytics pages and an MCP endpoint for the agent, over the coordinator and its store. Runs on its own or mounts in a Node http, Express or Fastify server.",
  "license": "Apache-2.0",
  "author": "Brightbeam AI <oss@brightbeam.com>",
  "homepage": "https://github.com/BrightbeamAI/chap/tree/main/packages/chap-server",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrightbeamAI/chap.git",
    "directory": "packages/chap-server"
  },
  "bugs": {
    "url": "https://github.com/BrightbeamAI/chap/issues"
  },
  "keywords": [
    "chap",
    "human-in-the-loop",
    "review",
    "audit",
    "mcp",
    "server"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "chap-server": "bin/chap-server.mjs"
  },
  "files": [
    "bin",
    "desk",
    "lib",
    "index.mjs",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./index.mjs",
    "./client": "./desk/chap-client.mjs",
    "./desk/*": "./desk/*",
    "./keys": "./lib/keys.mjs",
    "./providers": "./lib/providers.mjs",
    "./profiles-diff": "./lib/profiles-diff.mjs",
    "./oidc": "./lib/oidc.mjs",
    "./dev-issuer": "./lib/dev-issuer.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@brightbeamai/chap-coordinator": "^0.3.4",
    "@brightbeamai/chap-coordinator-mcp": "^0.3.4"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^29.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
