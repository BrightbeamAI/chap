{
  "name": "mcp-gate",
  "title": "MCP gate",
  "language": "typescript",
  "description": "Claude Desktop, Cursor or Claude Code connects to an MCP server over HTTP; every call that changes state is recorded and work that requires review waits for you in the desk.",
  "shared": {
    "python/analytics.py": "analytics.py"
  },
  "default_profiles": [
    "core/1.0",
    "review/1.0"
  ],
  "profile_choices": [
    "core/1.0",
    "review/1.0",
    "modes/1.0",
    "control/1.0",
    "whisper/1.0",
    "deliberation/1.0",
    "handoff/1.0",
    "routing/1.0",
    "audit-scitt/1.0"
  ],
  "defaults": {
    "workspace": "wsp_{name}",
    "human_uri": "human:you@local",
    "human_name": "You",
    "agent_uri": "agent:assistant"
  },
  "add": {
    "dir": "chap",
    "files": [
      "chap.config.json",
      "server.mjs",
      "AGENT_INSTRUCTIONS.md"
    ],
    "scripts": {
      "chap": "node {dir}/server.mjs"
    },
    "run": [
      "npm run chap"
    ],
    "gitignore": [
      "{dir}/data/",
      "{dir}/analytics/"
    ]
  },
  "run": [
    "npm install",
    "npm start"
  ]
}
