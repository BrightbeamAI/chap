{
  "name": "code-gate",
  "title": "Code gate",
  "language": "typescript",
  "description": "Every change a coding agent makes in a git repository is proposed as a patch, reviewed as a diff in the desk, signed by the reviewer, and committed only once approved, or reviewed as a branch, commit by commit, before it is pushed. Each governed commit names its reviewers and the model that wrote it, with the evidence beside it and a verifier for CI. Claude Code, Cursor, the built-in agent, or any agent that can run a command.",
  "shared": {
    "python/analytics.py": "analytics.py"
  },
  "default_profiles": [
    "core/1.0",
    "review/1.0",
    "modes/1.0",
    "control/1.0",
    "security-signed/1.0",
    "audit-scitt/1.0"
  ],
  "profile_choices": [
    "core/1.0",
    "review/1.0",
    "modes/1.0",
    "control/1.0",
    "whisper/1.0",
    "deliberation/1.0",
    "handoff/1.0",
    "routing/1.0",
    "audit-scitt/1.0",
    "identity-oidc/1.0",
    "security-signed/1.0"
  ],
  "defaults": {
    "workspace": "wsp_{name}",
    "human_uri": "human:you@local",
    "human_name": "You",
    "agent_uri": "agent:coder"
  },
  "add": {
    "dir": "chap",
    "files": [
      "chap.config.json",
      "server.mjs",
      "propose.mjs",
      "propose-branch.mjs",
      "verify.mjs",
      "install-hooks.mjs",
      "push-notes.mjs",
      "claude-session.mjs",
      "AGENT_INSTRUCTIONS.md"
    ],
    "scripts": {
      "chap": "node {dir}/server.mjs",
      "chap:hooks": "chap-code-gate install-hooks --gate {dir}",
      "chap:report": "chap-code-gate report --gate {dir}",
      "chap:stop": "chap-code-gate stop --gate {dir}"
    },
    "hooks": "chap:hooks",
    "run": [
      "npm run chap:hooks",
      "npm run chap"
    ],
    "gitignore": [
      "{dir}/data/",
      "{dir}/keys/",
      "{dir}/analytics/"
    ]
  },
  "run": [
    "npm install",
    "npm run demo"
  ]
}
