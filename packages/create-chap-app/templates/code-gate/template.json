{
  "name": "code-gate",
  "title": "Code gate",
  "language": "typescript",
  "description": "Every change a coding agent makes in a git repository is proposed as a patch, reviewed as a diff in the desk, signed by the reviewer, and committed only once approved, with the evidence beside the commit and a verifier for CI. Claude Code, Cursor, the built-in agent, or any agent that can run a command.",
  "shared": {
    "desk": "desk",
    "node/server.mjs": "server.mjs",
    "node/keys.mjs": "keys.mjs",
    "node/profiles-diff.mjs": "lib/profiles-diff.mjs",
    "node/oidc.mjs": "lib/oidc.mjs",
    "node/dev-issuer.mjs": "lib/dev-issuer.mjs",
    "node/providers.mjs": "lib/providers.mjs"
  },
  "default_profiles": [
    "core/1.0",
    "review/1.0",
    "modes/1.0",
    "control/1.0",
    "security-signed/1.0",
    "audit-scitt/1.0"
  ],
  "profile_choices": [
    "core/1.0",
    "review/1.0",
    "modes/1.0",
    "control/1.0",
    "whisper/1.0",
    "deliberation/1.0",
    "handoff/1.0",
    "routing/1.0",
    "audit-scitt/1.0",
    "identity-oidc/1.0",
    "security-signed/1.0"
  ],
  "defaults": {
    "workspace": "wsp_{name}",
    "human_uri": "human:you@local",
    "human_name": "You",
    "agent_uri": "agent:coder"
  },
  "run": [
    "npm install",
    "npm run keys",
    "npm start",
    "npm run demo-repo",
    "npm run agent",
    "open http://127.0.0.1:8791/"
  ]
}
