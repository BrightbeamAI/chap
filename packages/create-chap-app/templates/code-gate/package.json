{
  "name": "__PROJECT_NAME__",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A CHAP code gate: every change a coding agent makes is reviewed as a diff, signed, and committed only once approved, with the evidence beside the commit",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "demo": "node demo.mjs",
    "start": "node server.mjs",
    "stop": "chap-code-gate stop",
    "keys": "chap-server keys",
    "demo-repo": "node demo-repo.mjs",
    "agent": "node agent.mjs",
    "propose": "node propose.mjs",
    "propose-branch": "node propose-branch.mjs",
    "install-hooks": "node install-hooks.mjs",
    "verify": "node verify.mjs",
    "report": "chap-code-gate report",
    "analytics": "python3 analytics.py",
    "test": "node --test tests/*.test.mjs",
    "diff-profiles": "node diff-profiles.mjs",
    "trust": "chap-code-gate trust",
    "push-notes": "node push-notes.mjs"
  },
  "dependencies": {
    "@brightbeamai/chap-code-gate": "^0.3.5",
    "@brightbeamai/chap-server": "^0.3.5"
  }
}
