{
  "name": "outbound-approval",
  "title": "Outbound approval",
  "language": "python",
  "description": "The agent drafts outbound messages; each one is held until the named approver decides in the desk, and only an approved message reaches outbox/. A pause stops the agent until a person resumes it.",
  "shared": {
    "desk": "desk",
    "python/chap_server.py": "chap_server.py",
    "python/chap_client.py": "chap_client.py",
    "python/providers.py": "providers.py",
    "python/profiles_diff.py": "lib/profiles_diff.py"
  },
  "default_profiles": [
    "core/1.0",
    "review/1.0",
    "modes/1.0",
    "control/1.0"
  ],
  "profile_choices": [
    "core/1.0",
    "review/1.0",
    "modes/1.0",
    "control/1.0",
    "whisper/1.0",
    "deliberation/1.0",
    "handoff/1.0",
    "routing/1.0",
    "audit-scitt/1.0"
  ],
  "defaults": {
    "workspace": "wsp_{name}",
    "human_uri": "human:you@local",
    "human_name": "You",
    "agent_uri": "agent:drafter"
  },
  "run": [
    "pip install chap-coordinator",
    "python desk.py",
    "python agent.py messages.csv",
    "open http://127.0.0.1:8789/"
  ]
}
