              "patch": "diff --git a/packages/coordinator-mcp/src/index.ts b/packages/coordinator-mcp/src/index.ts\nindex 7f93fb4036405f77cf28095dc13d1b1944cc03c2..d368ae9aefcf1d5fcaa9297d85a8ae9764c1d82d 100644\n--- a/packages/coordinator-mcp/src/index.ts\n+++ b/packages/coordinator-mcp/src/index.ts\n@@ -90,7 +90,10 @@ const LIST_TTL_MS = 3_600_000;\n  */\n export const ServerDiscoverRequestSchema = z.object({\n   method: z.literal(\"server/discover\"),\n-  params: z.optional(z.object({ _meta: z.optional(z.record(z.string(), z.unknown())) }).loose()),\n+  // `.passthrough()` keeps unknown keys under zod 3 and zod 4 alike, and the\n+  // package accepts both majors. The zod 4 name for the same thing does not\n+  // exist in zod 3, where it stopped the package at import.\n+  params: z.optional(z.object({ _meta: z.optional(z.record(z.string(), z.unknown())) }).passthrough()),\n });\n \n export interface ChapMcpOptions {\ndiff --git a/packages/coordinator-mcp/tests/zod3_compat.test.ts b/packages/coordinator-mcp/tests/zod3_compat.test.ts\nnew file mode 100644\nindex 0000000000000000000000000000000000000000..e644ce67bc8fefea5c6d557a32b216c54653ee51\n--- /dev/null\n+++ b/packages/coordinator-mcp/tests/zod3_compat.test.ts\n@@ -0,0 +1,20 @@\n+/**\n+ * The package accepts zod `^3.25 || ^4.0`, so its source uses only the zod\n+ * API both majors provide. `.loose()` is zod 4 only: under zod 3 it stopped\n+ * the package at import with \"z.object(...).loose is not a function\".\n+ */\n+import { test } from \"node:test\";\n+import assert from \"node:assert/strict\";\n+import { readdirSync, readFileSync } from \"node:fs\";\n+\n+const ZOD4_ONLY = [/\\.loose\\(/, /\\blooseObject\\(/, /\\bstrictObject\\(/, /\\bz\\.toJSONSchema\\(/];\n+\n+test(\"the source calls no zod API that zod 3 lacks\", () => {\n+  const dir = new URL(\"../src/\", import.meta.url);\n+  for (const name of readdirSync(dir).filter((f) => f.endsWith(\".ts\"))) {\n+    const source = readFileSync(new URL(name, dir), \"utf8\");\n+    for (const pattern of ZOD4_ONLY) {\n+      assert.doesNotMatch(source, pattern, `${name} uses ${pattern}`);\n+    }\n+  }\n+});\n",
