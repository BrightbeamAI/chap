limits between them. The artefact's `result` is then empty. A\n+  coordinator refuses an override past its own `max_envelope_bytes`, 1 MiB\n+  by default, so every override a 0.3.4 coordinator accepted is rebuilt\n+  while that limit is at most 64 MiB.\n+\n ## 0.2.4\n \n ### Fixed\ndiff --git a/packages/chap-analytics/chap_analytics/__init__.py b/packages/chap-analytics/chap_analytics/__init__.py\nindex 80a5af7d7c9e30fc7db8fab12df5a3668b7221c1..b13786a7b08b2a04ff8d861f5f0f3d9ce158ca05 100644\n--- a/packages/chap-analytics/chap_analytics/__init__.py\n+++ b/packages/chap-analytics/chap_analytics/__init__.py\n@@ -41,7 +41,7 @@ The layers, bottom up:\n \"\"\"\n from __future__ import annotations\n \n-__version__ = \"0.2.4\"\n+__version__ = \"0.2.5\"\n \n from . import briefs, charts, export, graph, models, sample, stats, watch  # noqa: E402\n from .frames import Frames, frames  # noqa: E402\ndiff --git a/packages/chap-analytics/pyproject.toml b/packages/chap-analytics/pyproject.toml\nindex cdd2ee4d3daef9d1b13eb3cf3bba81f4b90d89a2..07437d0c12d8d51ed19225cf51cb5e96ef732fd2 100644\n--- a/packages/chap-analytics/pyproject.toml\n+++ b/packages/chap-analytics/pyproject.toml\n@@ -4,7 +4,7 @@ build-backend = \"setuptools.build_meta\"\n \n [project]\n name            = \"chap-analytics\"\n-version         = \"0.2.4\"\n+version         = \"0.2.5\"\n description     = \"The record of a collaboration between people and agents, measured and drawn: a CHAP audit chain as documented tables, statistics with their intervals, graphs, charts, briefs and a self-contained interactive report\"\n readme          = \"README.md\"\n requires-python = \">=3.10\"\n@@ -43,7 +43,7 @@ viz         = [\"altair>=5\", \"vl-convert-python>=1.0\"]\n graph       = [\"networkx>=3\"]\n # Regenerating examples/chap_analytics_walkthrough.ipynb with its outputs.\n notebook    = [\"nbformat>=5\", \"nbclient>=0.9\", \"ipykernel>=6\"]\n-dev         = [\"pytest>=8\", \"chap-coordinator>=0.3.0\", \"nbformat>=5\", \"al