st_a2a_skill_filter.py b/packages/coordinator-py/tests/test_a2a_skill_filter.py\nnew file mode 100644\nindex 0000000000000000000000000000000000000000..6452a0c78ddef2cb977c3fa8800d85941dbffd38\n--- /dev/null\n+++ b/packages/coordinator-py/tests/test_a2a_skill_filter.py\n@@ -0,0 +1,79 @@\n+\"\"\"\n+The executor refuses the skills its filter excludes.\n+\n+``skill_filter`` was an option of the Agent Card alone, which only lists\n+skills: the executor ran any ``chap.<method>`` it was sent. The executor now\n+takes the same filter and refuses what it excludes with -32601.\n+\n+Mirrors packages/coordinator-a2a/tests/skill_filter.test.ts.\n+\"\"\"\n+from __future__ import annotations\n+\n+import pytest\n+from a2a.server.agent_execution import RequestContext\n+from a2a.server.context import ServerCallContext\n+from a2a.server.events import EventQueue\n+from a2a.types import Message, Part, Role, SendMessageRequest\n+from google.protobuf.json_format import MessageToDict, ParseDict\n+from google.protobuf.struct_pb2 import Value\n+\n+from chap_coordinator.coordinator import Coordinator, CoordinatorOptions\n+from chap_coordinator.transports.a2a_server import (\n+    dispatch_a2a_message,\n+    make_chap_agent_executor,\n+)\n+\n+\n+class _Queue(EventQueue):\n+    def __init__(self) -> None:\n+        self.events: list = []\n+\n+    async def enqueue_event(self, event) -> None:  # type: ignore[no-untyped-def]\n+        self.events.append(event)\n+\n+\n+def _message(skill: str, params: dict) -> Message:\n+    data = Value()\n+    ParseDict({\"skill\": skill, \"params\": params}, data)\n+    return Message(message_id=\"m\", role=Role.ROLE_USER, parts=[Part(data=data)])\n+\n+\n+async def _run(executor, message: Message) -> dict:\n+    queue = _Queue()\n+    ctx = RequestContext(call_context=ServerCallContext(),\n+                         request=SendMessageRequest(message=message), context_id=\"c\")\n+    await executor.execute(ctx, queue)\n+    return MessageToDict(queue.events[0].parts[0].data)\n+\n+\n+@pytest.mark.asyncio\n+async def test_a_skill_the_filter_excludes_is_refused_and_runs_nothing():\n+    coord = Coordinator(CoordinatorOptions(deterministic_ids=True))\n+    executor = make_chap_agent_executor(coord, skill_filter=lambda s: s != \"chap.workspace.create\")\n+    body = await _run(executor, _message(\"chap.workspace.create\", {\"workspace\": \"w\"}))\n+    assert body[\"chap_error\"] == -32601\n+    assert \"not offered by this server: chap.workspace.create\" in body[\"message\"]\n+    assert coord.get_workspace(\"w\") is None\n+\n+\n+@pytest.mark.asyncio\n+async def test_a_skill_the_filter_keeps_runs_as_before():\n+    coord = Coordinator(CoordinatorOptions(deterministic_ids=True))\n+    executor = make_chap_agent_executor(coord, skill_filter=lambda s: s == \"chap.workspace.create\")\n+    body = await _run(executor, _message(\"chap.workspace.create\", {\"workspace\": \"w\"}))\n+    assert body[\"workspace\"] == \"w\"\n+\n+\n+@pytest.mark.asyncio\n+async def test_without_a_filter_every_skill_runs():\n+    coord = Coordinator(CoordinatorOptions(deterministic_ids=True))\n+    body = await _run(make_chap_agent_executor(coord),\n+                      _message(\"chap.workspace.create\", {\"workspace\": \"w\"}))\n+    assert body[\"workspace\"] == \"w\"\n+\n+\n+def test_dispatch_refuses_an_excluded_skill():\n+    coord = Coordinator(CoordinatorOptions(deterministic_ids=True))\n+    reply = dispatch_a2a_message(coord, _message(\"chap.workspace.create\", {\"workspace\": \"w\"}),\n+                                 skill_filter=lambda s: False)\n+    assert reply[\"error\"][\"code\"] == -32601\ndiff --git a/packages/coordinator-py/tests/test_mcp_filter_and_participant.py b/packages/coordinator-py/tests/test_mcp_filter_and_participant.py\nnew file mode 100644\nindex 0000000000000000000000000000000000000000..4d69ee17d5136abfa4ec0de8b51c79bbab9b00a5\n--- /dev/null\n+++ b/packages/coordinator-py/tests/test_mcp_filter_and_participant.py\n@@ -0,0 +1,82 @@\n+\"\"\"\n+The tool filter decides what the server offers, and ``participant`` makes\n+every call as one member.\n+\n+Before, ``tool_filter`` only left tools out of ``tools/list``: a client that\n+called an excluded tool by name still ran it. And every call named its own\n+``from``, so a connection meant for one agent could act in any member's name.\n+\n+Mirrors packages/coordinator-mcp/tests/filter_and_participant.test.ts.\n+\"\"\"\n+from __future__ import annotations\n+\n+import json\n+\n+import pytest\n+from mcp.client.client import Client\n+\n+from chap_coordinator.coordinator import Coordinator, CoordinatorOptions\n+from chap_coordinator.transports.mcp_server import make_chap_mcp_server\n+\n+\n+def _coord() -> Coordinator:\n+    c = Coordinator(CoordinatorOptions(deterministic_ids=True,\n+                                       default_profiles=[\"core/1.0\", \"review/1.0\"]))\n+    c.dispatch({\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"workspace.create\",\n+                \"params\": {\"workspace\": \"w\", \"from\": \"human:a\",\n+                           \"profiles\": [\"core/1.0\", \"review/1.0\"]}})\n+    for uri, kind in ((\"human:a\", \"human\"), (\"agent:b\", \"agent\")):\n+        c.dispatch({\"jsonrpc\": \"2.0\", \"id\": uri, \"method\": \"participant.join\",\n+                    \"params\": {\"workspace\": \"w\", \"from\": uri, \"type\": kind}})\n+    return c\n+\n+\n+def _text(result) -> str:\n+    return result.content[0].text if result.content else \"\"\n+\n+\n+@pytest.mark.asyncio\n+async def test_a_tool_the_filter_excludes_is_refused_as_well_as_left_out_of_the_list():\n+    coord = _coord()\n+    server = make_chap_mcp_server(coord, tool_filter=lambda name: name != \"chap.task.create\")\n+    async with Client(server) as client:\n+        names = {t.name for t in (await client.list_tools()).tools}\n+        assert \"chap.task.create\" not in names\n+        r = await client.call_tool(\"chap.task.create\", {\n+            \"workspace\": \"w\", \"from\": \"agent:b\", \"kind\": \"k\", \"input\": {}, \"assignee\": \"agent:b\"})\n+        assert r.is_error\n+        assert \"not offered by this server: chap.task.create\" in _text(r)\n+\n+\n+@pytest.mark.asyncio\n+async def test_participant_fills_in_from_and_refuses_a_call_that_names_another():\n+    coord = _coord()\n+    server = make_chap_mcp_server(coord, participant=\"agent:b\")\n+    async with Client(server) as client:\n+        made = await client.call_tool(\"chap.task.create\", {\n+            \"workspace\": \"w\", \"kind\": \"k\", \"input\": {}, \"assignee\": \"agent:b\"})\n+        assert not made.is_error, _text(made)\n+        tid = json.loads(_text(made))[\"task_id\"]\n+        assert coord.get_workspace(\"w\").tasks[tid].delegator == \"agent:b\"\n+\n+        same = await client.call_tool(\"chap.task.update\", {\n+            \"workspace\": \"w\", \"from\": \"agent:b\", \"task_id\": tid, \"state\": \"in_progress\"})\n+        assert not same.is_error, _text(same)\n+\n+        other = await client.call_tool(\"chap.task.update\", {\n+            \"workspace\": \"w\", \"from\": \"human:a\", \"task_id\": tid, \"state\": \"declined\"})\n+        assert other.is_error\n+        assert \"acts as agent:b\" in _text(other)\n+        assert coord.get_workspace(\"w\").tasks[tid].state == \"in_progress\"\n+\n+\n+@pytest.mark.asyncio\n+async def test_without_the_new_options_every_tool_runs_and_each_call_names_its_own_from():\n+    coord = _coord()\n+    server = make_chap_mcp_server(coord)\n+    async with Client(server) as client:\n+        made = await client.call_tool(\"chap.task.create\", {\n+            \"workspace\": \"w\", \"from\": \"human:a\", \"kind\": \"k\", \"input\": {}, \"assignee\": \"agent:b\"})\n+        assert not made.is_error, _text(made)\n+        tid = json.loads(_text(made))[\"task_id\"]\n+        assert coord.get_workspace(\"w\").tasks[tid].delegator == \"human:a\"\ndiff --git a/packages/create-chap-app/templates/_shared/node/server.mjs b/packages/create-chap-app/templates/_shared/node/server.mjs\nindex fd17b855f329bacce249d06095159c367231a6a0..88661808d6e4a48471ee01d60128486d961fa350 100644\n--- a/packages/create-chap-app/templates/_shared/node/server.mjs\n+++ b/packages/create-chap-app/templates/_shared/node/server.mjs\n@@ -440,6 +440,20 @@ async function readDirectory(dir) {\n   return files;\n }\n \n+// What the agent's MCP connection offers. `participant` makes every call as\n+// the agent, so the connection cannot act in another member's name, and the\n+// tools are the ones the agent's own work needs. The decision tools stay:\n+// called by the agent on its own work, the coordinator refuses them and\n+// records the attempt. What would let the agent decide its own work, or end a\n+// review it is under, is left out: review.request (an explicit review may name\n+// its own author), escalate.raise (it ends the open review, and the\n+// successor's review opens under the default rule), and every other tool.\n+export const AGENT_MCP_TOOLS = new Set([\n+  \"chap.task.create\", \"chap.task.update\", \"chap.task.complete\", \"chap.whisper.ask\",\n+  \"chap.decide.approve\", \"chap.decide.reject\", \"chap.decide.override\",\n+  \"chap.workspace.describe\", \"chap.audit.read\", \"chap.audit.verify_chain\",\n+]);\n+\n export async function makeServer(config, coord) {\n   // When a desk last asked for the health of the gate: a command that opens\n   // a review leaves an open desk to show it, and opens one otherwise.\n@@ -450,13 +464,17 @@ export async function makeServer(config, coord) {\n   // regenerated while the server runs is served as it is now.\n   const analyticsDir = join(here, \"analytics\");\n   let mcp = null;\n+  if (config.mcp && !config.agent?.uri) {\n+    throw new Error(\"chap.config.json turns on mcp, and /mcp acts as the agent: set agent.uri\");\n+  }\n   if (config.mcp) {\n     const { makeChapMcpServer } = await import(\"@brightbeamai/chap-coordinator-mcp\");\n   